<script>
  let customers = JSON.parse(localStorage.getItem('customers')) || [];
  let services  = JSON.parse(localStorage.getItem('services')) || [];
  let staffs    = JSON.parse(localStorage.getItem('staffs')) || [{id:'staff1', name:'ช่างคนที่ 1'}];
  if (!localStorage.getItem('staffs')) localStorage.setItem('staffs', JSON.stringify(staffs));
  let bookings  = JSON.parse(localStorage.getItem('bookings')) || [];
  let shopSettings = JSON.parse(localStorage.getItem('shopSettings')) || {
    name: 'THE PALETTE STUDIO BY KAT',
    address: '',
    taxId: '',
    phone: '',
    lineId: '',
    vatEnabled: true
  };

  const monthNames = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
  const dayNames = ['อา','จ','อ','พ','พฤ','ศ','ส'];

  const now = new Date();
  let viewYear = now.getFullYear();
  let viewMonth = now.getMonth();
  let currentModalDate = null;
  let editingBookingId = null;
  let editingCustomerId = null;
  let editingServiceId = null;
  let editingStaffId = null;
  let currentPaymentBookingId = null;
  let currentPaymentTab = 'today';

  function pad(n){ return n.toString().padStart(2,'0'); }
  function fmtDate(y,m,d){ return `${y}-${pad(m+1)}-${pad(d)}`; }
  function todayStr(){ const t=new Date(); return fmtDate(t.getFullYear(), t.getMonth(), t.getDate()); }
  function formatThaiDate(dateStr){ const [y,m,d]=dateStr.split('-').map(Number); return `${d} ${monthNames[m-1]} ${y+543}`; }
  function capitalize(s){ return s.charAt(0).toUpperCase()+s.slice(1); }
  function saveBookings(){ localStorage.setItem('bookings', JSON.stringify(bookings)); }
  function saveStaffs(){ localStorage.setItem('staffs', JSON.stringify(staffs)); }
  function saveCustomers(){ localStorage.setItem('customers', JSON.stringify(customers)); }
  function saveServices(){ localStorage.setItem('services', JSON.stringify(services)); }
  function saveShopSettings(){ localStorage.setItem('shopSettings', JSON.stringify(shopSettings)); }
  function isMobile(){ return window.innerWidth <= 480; }

  const colorPalette = [
    {bg:'#e3f2fd', text:'#1565c0'},
    {bg:'#fce4ec', text:'#ad1457'},
    {bg:'#e8f5e9', text:'#2e7d32'},
    {bg:'#fff3e0', text:'#e65100'},
    {bg:'#f3e5f5', text:'#6a1b9a'},
    {bg:'#fff9c4', text:'#f57f17'},
    {bg:'#e0f2f1', text:'#00695c'},
    {bg:'#fbe9e7', text:'#bf360c'},
  ];

  function getColorForStaff(staffId){
    if (!staffId) return colorPalette[0];
    let hash = 0;
    for (let i=0; i<staffId.length; i++) hash = staffId.charCodeAt(i) + ((hash << 5) - hash);
    const idx = Math.abs(hash) % colorPalette.length;
    return colorPalette[idx];
  }

  /* ================= PAYMENT BADGE HELPER ================= */
  function paymentBadgeHtml(b){
    if (b.paid){
      return `<span class="paid-badge">✅ ชำระแล้ว ${Number(b.netTotal).toLocaleString()} บาท</span>`;
    }
    return `<button class="btn-pay" onclick="openPaymentModal('${b.id}')">💰 คิดเงิน</button>`;
  }

  /* ================= CONFLICT DETECTION ================= */
  function timeOverlap(s1,e1,s2,e2){ return s1 < e2 && s2 < e1; }

  function findConflicts(staffId, date, startTime, endTime, excludeId=null){
    if (!staffId) return [];
    return bookings.filter(b =>
      b.staffId === staffId &&
      b.date === date &&
      b.id !== excludeId &&
      timeOverlap(startTime, endTime, b.startTime, b.endTime)
    );
  }

  function dateHasConflicts(dateStr){
    const dayBookings = bookings.filter(b=>b.date===dateStr);
    for (let i=0;i<dayBookings.length;i++){
      for (let j=i+1;j<dayBookings.length;j++){
        const a=dayBookings[i], b=dayBookings[j];
        if (a.staffId && a.staffId===b.staffId && timeOverlap(a.startTime,a.endTime,b.startTime,b.endTime)) return true;
      }
    }
    return false;
  }

  /* ================= NAVIGATION ================= */
  function switchView(view){
    ['home','calendar','search','payment','summary','manage'].forEach(v=>{
      document.getElementById('view-'+v).classList.toggle('active', v===view);
      document.getElementById('nav'+capitalize(v)).classList.toggle('active', v===view);
    });
    if (view==='home') renderHome();
    if (view==='calendar') renderCalendar();
    if (view==='payment') renderPaymentList(currentPaymentTab);
    if (view==='search') renderSearchResults();
    if (view==='summary'){
      const tStr = todayStr();
      const monthStr = `${now.getFullYear()}-${pad(now.getMonth()+1)}`;
      const dEl = document.getElementById('summaryDate');
      const mEl = document.getElementById('summaryMonth');
      if (!dEl.value) dEl.value = tStr;
      if (!mEl.value) mEl.value = monthStr;
      renderDailySummary(dEl.value);
    }
    if (view==='manage'){
      switchManageTab('customers');
    }
  }

  /* ================= HOME ================= */
  function renderHome(){
    const tStr = todayStr();
    document.getElementById('homeDateLabel').textContent = `📆 วันนี้ ${formatThaiDate(tStr)}`;

    const todaysBookings = bookings.filter(b=>b.date===tStr);
    const unpaidTodayCount = todaysBookings.filter(b=>!b.paid).length;
    const unpaidAllCount = bookings.filter(b=>!b.paid).length;
    const todayRevenue = todaysBookings.filter(b=>b.paid).reduce((s,b)=>s+Number(b.netTotal||0),0);

    document.getElementById('homeStats').innerHTML = `
      <div class="stat-card"><div class="stat-value">${todaysBookings.length}</div><div class="stat-label">คิววันนี้</div></div>
      <div class="stat-card"><div class="stat-value" style="color:${unpaidTodayCount>0?'var(--color-danger)':'var(--color-blue)'};">${unpaidTodayCount}</div><div class="stat-label">รอชำระวันนี้</div></div>
      <div class="stat-card"><div class="stat-value" style="color:var(--color-blue);">${todayRevenue.toLocaleString()}</div><div class="stat-label">รายได้วันนี้ (บาท)</div></div>
    `;

    const badgeCal = document.getElementById('badgeCalendar');
    if (todaysBookings.length>0){ badgeCal.style.display='inline-block'; badgeCal.textContent = todaysBookings.length; } else badgeCal.style.display='none';

    const badgePay = document.getElementById('badgePayment');
    if (unpaidAllCount>0){ badgePay.style.display='inline-block'; badgePay.textContent = unpaidAllCount; } else badgePay.style.display='none';
  }

  /* ================= CALENDAR ================= */
  function renderStaffLegend(){
    const legend = document.getElementById('staffLegend');
    legend.innerHTML = staffs.map(s=>{
      const c = getColorForStaff(s.id);
      return `<div class="legend-item"><span class="legend-dot" style="background:${c.text};"></span>${s.name}</div>`;
    }).join('');
  }

  function renderCalendar(){
    document.getElementById('monthYearLabel').textContent = `${monthNames[viewMonth]} ${viewYear+543}`;
    const grid = document.getElementById('calendarGrid');
    grid.innerHTML = '';
    dayNames.forEach(d => grid.innerHTML += `<div class="day-name">${d}</div>`);

    const firstDay = new Date(viewYear, viewMonth, 1).getDay();
    const daysInMonth = new Date(viewYear, viewMonth+1, 0).getDate();
    for (let i=0;i<firstDay;i++) grid.innerHTML += `<div class="day-cell empty"></div>`;

    const tStr = todayStr();
    const mobile = isMobile();

    for (let d=1; d<=daysInMonth; d++){
      const dateStr = fmtDate(viewYear, viewMonth, d);
      const dayBookings = bookings.filter(b=>b.date===dateStr).sort((a,b)=>a.startTime.localeCompare(b.startTime));
      const isToday = dateStr===tStr ? 'today':'';
      const hasConflict = dateHasConflicts(dateStr);

      let content = '';
      if (mobile){
        const dots = dayBookings.slice(0,6).map(b=>{
          const c = getColorForStaff(b.staffId);
          return `<span class="day-dot" style="background:${c.text};"></span>`;
        }).join('');
        content = `<div class="day-dots">${dots}</div>`;
      } else {
        let chips = dayBookings.slice(0,3).map(b=>{
          const c = getColorForStaff(b.staffId);
          return `<div class="booking-chip" style="background:${c.bg}; color:${c.text};">${b.startTime} ${b.customerName}</div>`;
        }).join('');
        if (dayBookings.length>3) chips += `<div class="more-chip">+${dayBookings.length-3} เพิ่มเติม</div>`;
        content = chips;
      }

      grid.innerHTML += `<div class="day-cell ${isToday}" onclick="openDayModal('${dateStr}')">
        <div class="day-num">${d}${hasConflict?' <span style="color:var(--color-danger);">⚠️</span>':''}</div>${content}
      </div>`;
    }
    renderStaffLegend();
  }

  window.addEventListener('resize', ()=>{ if (document.getElementById('view-calendar').classList.contains('active')) renderCalendar(); });

  function changeMonth(diff){
    viewMonth += diff;
    if (viewMonth<0){ viewMonth=11; viewYear--; }
    if (viewMonth>11){ viewMonth=0; viewYear++; }
    renderCalendar();
  }

  function openDayModal(dateStr){
    currentModalDate = dateStr;
    const [y,m,d] = dateStr.split('-').map(Number);
    document.getElementById('dayModalTitle').textContent = `📋 วันที่ ${d} ${monthNames[m-1]} ${y+543}`;
    renderDayTimeline(dateStr);
    document.getElementById('dayModal').classList.add('show');
  }

  function renderDayTimeline(dateStr){
    const dayBookings = bookings.filter(b=>b.date===dateStr).sort((a,b)=>a.startTime.localeCompare(b.startTime));
    const container = document.getElementById('dayTimeline');
    if (dayBookings.length===0){
      container.innerHTML = `<p style="color:#999; text-align:center; padding:20px;">ยังไม่มีคิวในวันนี้</p>`;
      return;
    }
    container.innerHTML = dayBookings.map(b=>{
      const c = getColorForStaff(b.staffId);
      const conflicts = findConflicts(b.staffId, b.date, b.startTime, b.endTime, b.id);
      const warnHtml = conflicts.length>0
        ? `<br><span class="conflict-warn">⚠️ คิวชนกับ ${conflicts.map(x=>x.customerName).join(', ')}</span>`
        : '';
      const borderColor = conflicts.length>0 ? 'var(--color-danger)' : c.text;
      return `
      <div class="booking-card" style="border-left:5px solid ${borderColor}; background:${c.bg};">
        <div class="booking-time">${b.startTime}<br>-${b.endTime}</div>
        <div class="booking-info">
          <b>${b.customerName}</b> ${b.customerPhone?('('+b.customerPhone+')'):''}<br>
          บริการ: ${b.serviceNames.join(', ')}<br>
          ช่าง: ${b.staffName} | รวม ${b.totalDuration} นาที | ${Number(b.totalPrice).toLocaleString()} บาท
          ${b.note?('<br>📝 '+b.note):''}
          ${warnHtml}
        </div>
        <div class="booking-actions">
          <button class="btn-edit" onclick="editBooking('${b.id}')">แก้ไข</button>
          <button class="btn-delete" onclick="deleteBooking('${b.id}')">ลบ</button>
          ${paymentBadgeHtml(b)}
        </div>
      </div>
    `;
    }).join('');
  }

  function closeModal(id){ document.getElementById(id).classList.remove('show'); }

  /* ================= SEARCH ================= */
  function renderSearchResults(){
    const q = document.getElementById('searchQuery').value.trim().toLowerCase();
    const from = document.getElementById('searchFrom').value;
    const to = document.getElementById('searchTo').value;
    const container = document.getElementById('searchResults');

    if (!q && !from && !to){
      container.innerHTML = `<p style="color:#999;text-align:center;padding:20px;">พิมพ์ชื่อลูกค้า/ช่าง หรือเลือกช่วงวันที่ เพื่อค้นหาคิว</p>`;
      return;
    }

    let results = bookings.filter(b=>{
      let match = true;
      if (q) match = (b.customerName||'').toLowerCase().includes(q) || (b.staffName||'').toLowerCase().includes(q);
      if (match && from) match = b.date >= from;
      if (match && to) match = b.date <= to;
      return match;
    });
    results.sort((a,b)=> a.date===b.date ? a.startTime.localeCompare(b.startTime) : a.date.localeCompare(b.date));

    if (results.length===0){
      container.innerHTML = `<p style="color:#999;text-align:center;padding:20px;">ไม่พบคิวที่ตรงกับคำค้นหา</p>`;
      return;
    }

    container.innerHTML = `<p style="color:#666;font-size:13px;margin-bottom:8px;">พบ ${results.length} รายการ</p>` +
      results.map(b=>{
        const c = getColorForStaff(b.staffId);
        const conflicts = findConflicts(b.staffId, b.date, b.startTime, b.endTime, b.id);
        const warnHtml = conflicts.length>0 ? `<br><span class="conflict-warn">⚠️ คิวชนกับช่างคนเดียวกัน</span>` : '';
        const borderColor = conflicts.length>0 ? 'var(--color-danger)' : c.text;
        return `
        <div class="booking-card" style="border-left:5px solid ${borderColor}; background:${c.bg};">
          <div class="booking-time">${formatThaiDate(b.date)}<br>${b.startTime}-${b.endTime}</div>
          <div class="booking-info">
            <b>${b.customerName}</b> ${b.customerPhone?('('+b.customerPhone+')'):''}<br>
            บริการ: ${b.serviceNames.join(', ')}<br>
            ช่าง: ${b.staffName} | ${Number(b.totalPrice).toLocaleString()} บาท${warnHtml}
          </div>
          <div class="booking-actions">
            <button class="btn-edit" onclick="editBooking('${b.id}')">แก้ไข</button>
            <button class="btn-delete" onclick="deleteBooking('${b.id}')">ลบ</button>
            ${paymentBadgeHtml(b)}
          </div>
        </div>
      `;
      }).join('');
  }

  function refreshAfterBookingChange(){
    renderHome();
    if (document.getElementById('view-calendar').classList.contains('active')) renderCalendar();
    if (currentModalDate) renderDayTimeline(currentModalDate);
    if (document.getElementById('view-search').classList.contains('active')) renderSearchResults();
    if (document.getElementById('view-payment').classList.contains('active')) renderPaymentList(currentPaymentTab);
  }

  /* ================= BOOKING FORM HELPERS ================= */
  function populateCustomerSelect(selectedId=null){
    const sel = document.getElementById('bCustomer');
    sel.innerHTML = '<option value="">-- เลือกลูกค้า --</option>';
    if (customers.length===0){
      sel.innerHTML += `<option disabled>⚠️ ยังไม่มีข้อมูลลูกค้า กด "➕ ลูกค้าใหม่" เพื่อเพิ่ม</option>`;
    }
    customers.forEach(c=>{
      const name = c.name || 'ไม่ทราบชื่อ';
      const phone = c.phone || '';
      sel.innerHTML += `<option value="${c.id}" data-phone="${phone}" data-name="${name}">${name}${phone?(' - '+phone):''}</option>`;
    });
    if (selectedId) sel.value = selectedId;
  }

  function populateServiceChecklist(){
    const container = document.getElementById('bServices');
    if (services.length===0){
      container.innerHTML = `<p style="color:#999;">⚠️ ยังไม่มีรายการบริการ กด "จัดการ" เพื่อเพิ่มก่อน</p>`;
      return;
    }
    container.innerHTML = services.map(s=>`
      <label class="service-item">
        <input type="checkbox" value="${s.id}" data-duration="${s.duration||0}" data-price="${s.price||0}" data-name="${s.name}" onchange="calcTotals()">
        ${s.name} (${Number(s.price).toLocaleString()} บาท / ${s.duration||0} นาที)
      </label>
    `).join('');
  }

  function populateStaffSelect(){
    document.getElementById('bStaff').innerHTML = staffs.map(s=>`<option value="${s.id}">${s.name}</option>`).join('');
  }

  function addStaff(){
    const nameInput = document.getElementById('newStaffName');
    const name = nameInput.value.trim();
    if (!name) return;
    const newStaff = { id:'staff'+Date.now(), name };
    staffs.push(newStaff);
    saveStaffs();
    populateStaffSelect();
    document.getElementById('bStaff').value = newStaff.id;
    nameInput.value = '';
    renderStaffLegend();
  }

  function calcTotals(){
    const checked = document.querySelectorAll('#bServices input[type=checkbox]:checked');
    let dur=0, price=0;
    checked.forEach(c=>{ dur += Number(c.dataset.duration)||0; price += Number(c.dataset.price)||0; });
    document.getElementById('sumDuration').textContent = dur;
    document.getElementById('sumPrice').textContent = price.toLocaleString();
    updateEndTime();
  }

  function updateEndTime(){
    const start = document.getElementById('bStartTime').value;
    const dur = Number(document.getElementById('sumDuration').textContent)||0;
    if (!start){ document.getElementById('bEndTime').value=''; return; }
    const [h,m] = start.split(':').map(Number);
    const totalMin = h*60+m+dur;
    document.getElementById('bEndTime').value = `${pad(Math.floor(totalMin/60)%24)}:${pad(totalMin%60)}`;
  }
  document.getElementById('bStartTime').addEventListener('change', updateEndTime);

  function openBookingForm(prefillDate=null){
    editingBookingId = null;
    document.getElementById('bookingModalTitle').textContent = '➕ จองคิวใหม่';
    populateCustomerSelect();
    populateServiceChecklist();
    populateStaffSelect();
    document.getElementById('bookingForm').reset();
    document.getElementById('sumDuration').textContent='0';
    document.getElementById('sumPrice').textContent='0';
    document.getElementById('bEndTime').value='';
    if (prefillDate) document.getElementById('bDate').value = prefillDate;
    document.getElementById('bookingModal').classList.add('show');
  }

  document.getElementById('bookingForm').addEventListener('submit', function(e){
    e.preventDefault();
    const customerSel = document.getElementById('bCustomer');
    const customerId = customerSel.value;
    if (!customerId){ alert('กรุณาเลือกลูกค้า'); return; }
    const opt = customerSel.options[customerSel.selectedIndex];
    const customerName = opt.dataset.name;
    const customerPhone = opt.dataset.phone || '';

    const checked = document.querySelectorAll('#bServices input[type=checkbox]:checked');
    if (checked.length===0){ alert('กรุณาเลือกบริการอย่างน้อย 1 รายการ'); return; }
    const serviceIds = [...checked].map(c=>c.value);
    const serviceNames = [...checked].map(c=>c.dataset.name);
    const serviceItems = [...checked].map(c=>({ name:c.dataset.name, price:Number(c.dataset.price)||0, qty:1 }));
    let totalDuration=0, totalPrice=0;
    checked.forEach(c=>{ totalDuration += Number(c.dataset.duration)||0; totalPrice += Number(c.dataset.price)||0; });

    const date = document.getElementById('bDate').value;
    const startTime = document.getElementById('bStartTime').value;
    const endTime = document.getElementById('bEndTime').value;
    const staffSel = document.getElementById('bStaff');
    const staffId = staffSel.value;
    const staffName = staffSel.options[staffSel.selectedIndex]?.text || '';
    const note = document.getElementById('bNote').value.trim();

    const conflicts = findConflicts(staffId, date, startTime, endTime, editingBookingId);
    if (conflicts.length > 0){
      const listStr = conflicts.map(c=>`• ${c.customerName} (${c.startTime}-${c.endTime})`).join('\n');
      const proceed = confirm(`⚠️ ช่าง "${staffName}" มีคิวชนกับเวลาที่เลือกอยู่แล้ว:\n${listStr}\n\nต้องการบันทึกคิวนี้ต่อหรือไม่?`);
      if (!proceed) return;
    }

    if (editingBookingId){
      const idx = bookings.findIndex(b=>b.id===editingBookingId);
      bookings[idx] = { ...bookings[idx], customerId, customerName, customerPhone, serviceIds, serviceNames, serviceItems, totalDuration, totalPrice, date, startTime, endTime, staffId, staffName, note };
    } else {
      bookings.push({ id: Date.now().toString(), customerId, customerName, customerPhone, serviceIds, serviceNames, serviceItems, totalDuration, totalPrice, date, startTime, endTime, staffId, staffName, note, paid:false, discount:0, netTotal:null, paymentMethod:null, paidAt:null, receiptNo:null, cashierId:null, cashierName:null });
    }
    saveBookings();
    closeModal('bookingModal');
    refreshAfterBookingChange();
  });

  function editBooking(id){
    const b = bookings.find(x=>x.id===id);
    if (!b) return;
    editingBookingId = id;
    document.getElementById('bookingModalTitle').textContent = '✏️ แก้ไขคิว';
    populateCustomerSelect();
    populateServiceChecklist();
    populateStaffSelect();
    document.getElementById('bCustomer').value = b.customerId;
    document.getElementById('bDate').value = b.date;
    document.getElementById('bStartTime').value = b.startTime;
    document.getElementById('bStaff').value = b.staffId;
    document.getElementById('bNote').value = b.note || '';
    document.querySelectorAll('#bServices input[type=checkbox]').forEach(cb=>{
      cb.checked = b.serviceIds.includes(cb.value);
    });
    calcTotals();
    document.getElementById('bookingModal').classList.add('show');
  }

  function deleteBooking(id){
    if (confirm('ยืนยันการลบคิวนี้?')){
      bookings = bookings.filter(b=>b.id!==id);
      saveBookings();
      refreshAfterBookingChange();
    }
  }

  /* ================= PAYMENT ================= */
  function switchPaymentTab(tab){
    currentPaymentTab = tab;
    ['today','all','history'].forEach(t=>{
      document.getElementById('payTab'+capitalize(t)).classList.toggle('active', t===tab);
    });
    renderPaymentList(tab);
  }

  function renderPaymentList(tab){
    const tStr = todayStr();
    let list;
    if (tab==='today') list = bookings.filter(b=>!b.paid && b.date===tStr);
    else if (tab==='all') list = bookings.filter(b=>!b.paid);
    else list = bookings.filter(b=>b.paid);

    if (tab==='history') list = list.slice().sort((a,b)=> new Date(b.paidAt) - new Date(a.paidAt));
    else list = list.slice().sort((a,b)=> a.date===b.date ? a.startTime.localeCompare(b.startTime) : a.date.localeCompare(b.date));

    const container = document.getElementById('paymentListResult');
    if (list.length===0){
      container.innerHTML = `<p style="color:#999;text-align:center;padding:20px;">${tab==='history' ? 'ยังไม่มีประวัติการชำระเงิน' : 'ไม่มีคิวที่รอชำระเงิน 🎉'}</p>`;
      return;
    }
    container.innerHTML = list.map(b=>{
      const c = getColorForStaff(b.staffId);
      const actionHtml = tab==='history'
        ? `<button class="btn-receipt" onclick="openReceipt('${b.id}')">🧾 ใบเสร็จ</button>`
        : `<button class="btn-pay" onclick="openPaymentModal('${b.id}')">💰 คิดเงิน</button>`;
      return `
      <div class="booking-card" style="border-left:5px solid ${c.text}; background:${c.bg};">
        <div class="booking-time">${formatThaiDate(b.date)}<br>${b.startTime}-${b.endTime}</div>
        <div class="booking-info">
          <b>${b.customerName}</b> ${b.customerPhone?('('+b.customerPhone+')'):''}<br>
          บริการ: ${b.serviceNames.join(', ')}<br>
          ช่าง: ${b.staffName} | ${b.paid ? ('ชำระแล้ว '+Number(b.netTotal).toLocaleString()) : Number(b.totalPrice).toLocaleString()} บาท
        </div>
        <div class="booking-actions">${actionHtml}</div>
      </div>
    `;
    }).join('');
  }

  function openPaymentModal(id){
    currentPaymentBookingId = id;
    const b = bookings.find(x=>x.id===id);
    if (!b) return;
    document.getElementById('paymentBookingInfo').innerHTML = `
      <b>${b.customerName}</b> ${b.customerPhone?('('+b.customerPhone+')'):''}<br>
      📅 ${formatThaiDate(b.date)} เวลา ${b.startTime}-${b.endTime}<br>
      บริการ: ${b.serviceNames.join(', ')}<br>
      ช่าง: ${b.staffName}
    `;
    const cashierSel = document.getElementById('payCashier');
    cashierSel.innerHTML = staffs.map(s=>`<option value="${s.id}">${s.name}</option>`).join('');
    cashierSel.value = b.cashierId || b.staffId || (staffs[0]?.id || '');
    document.getElementById('payDiscount').value = b.discount || 0;
    document.getElementById('payMethod').value = b.paymentMethod || 'เงินสด';
    document.getElementById('payGross').textContent = Number(b.totalPrice).toLocaleString();
    updatePaymentNet();
    document.getElementById('paymentModal').classList.add('show');
  }

  function updatePaymentNet(){
    const b = bookings.find(x=>x.id===currentPaymentBookingId);
    if (!b) return;
    const discount = Number(document.getElementById('payDiscount').value)||0;
    const net = Math.max(0, Number(b.totalPrice) - discount);
    document.getElementById('payNet').textContent = net.toLocaleString();
  }

  function getNextReceiptNo(){
    let counter = Number(localStorage.getItem('receiptCounter')||0) + 1;
    localStorage.setItem('receiptCounter', counter);
    return 'RC' + counter.toString().padStart(6,'0');
  }

  function confirmPayment(){
    const b = bookings.find(x=>x.id===currentPaymentBookingId);
    if (!b) return;
    const discount = Number(document.getElementById('payDiscount').value)||0;
    const net = Math.max(0, Number(b.totalPrice) - discount);
    const method = document.getElementById('payMethod').value;
    const cashierSel = document.getElementById('payCashier');
    const cashierId = cashierSel.value;
    const cashierName = cashierSel.options[cashierSel.selectedIndex]?.text || '';
    b.paid = true;
    b.discount = discount;
    b.netTotal = net;
    b.paymentMethod = method;
    b.paidAt = new Date().toISOString();
    b.cashierId = cashierId;
    b.cashierName = cashierName;
    if (!b.receiptNo) b.receiptNo = getNextReceiptNo();
    saveBookings();
    closeModal('paymentModal');
    openReceipt(b.id);
    refreshAfterBookingChange();
  }

  /* ================= RECEIPT ================= */
  function calcVAT(net){
    const rate = 0.07;
    const exVat = net / (1+rate);
    const vat = net - exVat;
    return { exVat, vat };
  }

  function openReceipt(id){
    const b = bookings.find(x=>x.id===id);
    if (!b) return;
    const paidDate = b.paidAt ? new Date(b.paidAt) : new Date();
    const dateStr = `${pad(paidDate.getDate())}/${pad(paidDate.getMonth()+1)}/${paidDate.getFullYear()+543}`;
    const timeStr = `${pad(paidDate.getHours())}:${pad(paidDate.getMinutes())} น.`;

    const items = (b.serviceItems && b.serviceItems.length)
      ? b.serviceItems
      : [{ name: b.serviceNames.join(', '), price: Number(b.totalPrice), qty:1 }];

    const itemCount = items.reduce((s,i)=>s+(i.qty||1),0);
    const subTotal = items.reduce((s,i)=>s+(i.price*(i.qty||1)),0);
    const discount = Number(b.discount||0);
    const afterDiscount = Number(b.netTotal);

    let vatHtml = '';
    if (shopSettings.vatEnabled){
      const { exVat, vat } = calcVAT(afterDiscount);
      vatHtml = `
        <div class="receipt-row"><span>ภาษีมูลค่าเพิ่ม 7%</span><span>${vat.toFixed(2)}</span></div>
        <div class="receipt-row"><span>ราคาไม่รวม VAT</span><span>${exVat.toFixed(2)}</span></div>
      `;
    }

    const itemsHtml = items.map(i=>`
      <div class="receipt-item-row">
        <span class="ri-qty">${i.qty||1}</span>
        <span class="ri-name">${i.name}</span>
        <span class="ri-price">${(i.price*(i.qty||1)).toFixed(2)}</span>
      </div>
    `).join('');

    const addressHtml = shopSettings.address ? `<div style="font-size:11px;color:#666;">${shopSettings.address.replace(/\n/g,'<br>')}</div>` : '';
    const taxIdHtml = shopSettings.taxId ? `<div style="font-size:11px;color:#666;">เลขผู้เสียภาษี: ${shopSettings.taxId}</div>` : '';
    const contactHtml = (shopSettings.phone || shopSettings.lineId)
      ? `<div style="font-size:11px;color:#666;">${shopSettings.phone ? ('โทร. '+shopSettings.phone) : ''}${(shopSettings.phone && shopSettings.lineId) ? ' | ' : ''}${shopSettings.lineId ? ('LINE: '+shopSettings.lineId) : ''}</div>`
      : '';

    document.getElementById('receiptPrintArea').innerHTML = `
      <div style="text-align:center;">
        <img src="logo.png" style="max-width:64px;margin-bottom:6px;" onerror="this.style.display='none';">
        <h3 style="margin:2px 0;font-size:16px;">${shopSettings.name}</h3>
        ${addressHtml}
        ${taxIdHtml}
        ${contactHtml}
      </div>
      <hr>
      <div style="text-align:center;font-size:13px;font-weight:bold;">ใบกำกับภาษีอย่างย่อ/ใบเสร็จรับเงิน</div>
      <div style="text-align:center;font-size:12px;color:#666;">เลขที่: ${b.receiptNo || '-'}</div>
      <hr>
      <div class="receipt-row"><span>พนักงานขาย</span><span>${b.cashierName || b.staffName}</span></div>
      <div class="receipt-row"><span>วันที่</span><span>${dateStr}</span></div>
      <div class="receipt-row"><span>เวลา</span><span>${timeStr}</span></div>
      <hr>
      ${itemsHtml}
      <hr>
      <div class="receipt-row"><span>จำนวนรวม</span><span>${itemCount}</span></div>
      <div class="receipt-row"><span>รวมเป็นเงิน</span><span>${subTotal.toFixed(2)}</span></div>
      <div class="receipt-row"><span>ส่วนลด</span><span>${discount.toFixed(2)}</span></div>
      <div class="receipt-row"><span>หลังหักส่วนลด</span><span>${afterDiscount.toFixed(2)}</span></div>
      ${vatHtml}
      <div class="receipt-row" style="font-size:16px;font-weight:bold;color:var(--color-blue);border-top:2px solid #333;padding-top:6px;margin-top:4px;">
        <span>รวมทั้งสิ้น</span><span>${afterDiscount.toFixed(2)}</span>
      </div>
      ${shopSettings.vatEnabled ? `<div style="text-align:center;font-size:10px;color:#999;margin-top:2px;">VAT INCLUDED</div>` : ''}
      <div style="font-size:11px;color:#888;margin-top:8px;">วิธีชำระ: ${b.paymentMethod}</div>
      <hr>
      <div style="text-align:center;font-size:12px;color:#888;">ขอบคุณที่ใช้บริการค่ะ 🙏</div>
      ${shopSettings.lineId ? `<div style="text-align:center;font-size:11px;color:#888;">ติดตามร้านได้ที่ LINE: ${shopSettings.lineId}</div>` : ''}
    `;
    document.getElementById('receiptModal').classList.add('show');
  }

  function printReceipt(){ window.print(); }

  /* ================= SUMMARY ================= */
  function switchSummaryMode(mode){
    document.getElementById('modeDaily').classList.toggle('active', mode==='daily');
    document.getElementById('modeMonthly').classList.toggle('active', mode==='monthly');
    document.getElementById('dailyPicker').style.display = mode==='daily' ? 'block':'none';
    document.getElementById('monthlyPicker').style.display = mode==='monthly' ? 'block':'none';
    if (mode==='daily') renderDailySummary(document.getElementById('summaryDate').value);
    else renderMonthlySummary(document.getElementById('summaryMonth').value);
  }

  function renderDailySummary(dateStr){
    if (!dateStr) return;
    const dayBookings = bookings.filter(b=>b.date===dateStr);
    const totalCount = dayBookings.length;
    const totalBooked = dayBookings.reduce((s,b)=>s+Number(b.totalPrice||0),0);
    const totalCollected = dayBookings.filter(b=>b.paid).reduce((s,b)=>s+Number(b.netTotal||0),0);
    const totalPending = dayBookings.filter(b=>!b.paid).length;
    const staffMap = {};
    dayBookings.forEach(b=>{
      const key = b.staffName || 'ไม่ระบุ';
      if (!staffMap[key]) staffMap[key] = {count:0, revenue:0};
      staffMap[key].count++;
      staffMap[key].revenue += Number(b.paid ? b.netTotal : b.totalPrice) || 0;
    });
    let html = `
      <div class="stat-grid">
        <div class="stat-card"><div class="stat-value">${totalCount}</div><div class="stat-label">จำนวนคิว</div></div>
        <div class="stat-card"><div class="stat-value">${totalBooked.toLocaleString()}</div><div class="stat-label">ยอดจอง (บาท)</div></div>
        <div class="stat-card"><div class="stat-value" style="color:var(--color-blue);">${totalCollected.toLocaleString()}</div><div class="stat-label">เก็บเงินแล้ว (บาท)</div></div>
        <div class="stat-card"><div class="stat-value" style="color:${totalPending>0?'var(--color-danger)':'var(--color-blue)'};">${totalPending}</div><div class="stat-label">รอชำระ (คิว)</div></div>
      </div>
      <h4>👤 แยกตามช่าง</h4>
      <div class="table-wrap"><table class="data-table"><tr><th>ช่าง</th><th>จำนวนคิว</th><th>รายได้ (บาท)</th></tr>
      ${Object.keys(staffMap).length===0 ? '<tr><td colspan="3" style="text-align:center;color:#999;">ไม่มีคิวในวันนี้</td></tr>' :
        Object.entries(staffMap).map(([name,v])=>`<tr><td>${name}</td><td>${v.count}</td><td>${v.revenue.toLocaleString()}</td></tr>`).join('')}
      </table></div>
      <h4>📋 รายการคิว</h4>
      <div class="table-wrap"><table class="data-table"><tr><th>เวลา</th><th>ลูกค้า</th><th>บริการ</th><th>ช่าง</th><th>ราคา</th><th>สถานะ</th></tr>
      ${dayBookings.length===0 ? '<tr><td colspan="6" style="text-align:center;color:#999;">ไม่มีคิว</td></tr>' :
        dayBookings.sort((a,b)=>a.startTime.localeCompare(b.startTime)).map(b=>`<tr><td>${b.startTime}</td><td>${b.customerName}</td><td>${b.serviceNames.join(', ')}</td><td>${b.staffName}</td><td>${Number(b.totalPrice).toLocaleString()}</td><td>${b.paid?'✅ จ่ายแล้ว':'⏳ รอชำระ'}</td></tr>`).join('')}
      </table></div>
    `;
    document.getElementById('summaryResult').innerHTML = html;
  }

  function renderMonthlySummary(ymStr){
    if (!ymStr) return;
    const monthBookings = bookings.filter(b=>b.date && b.date.startsWith(ymStr));
    const totalCount = monthBookings.length;
    const totalBooked = monthBookings.reduce((s,b)=>s+Number(b.totalPrice||0),0);
    const totalCollected = monthBookings.filter(b=>b.paid).reduce((s,b)=>s+Number(b.netTotal||0),0);
    const totalPending = monthBookings.filter(b=>!b.paid).length;
    const staffMap = {};
    monthBookings.forEach(b=>{
      const key = b.staffName || 'ไม่ระบุ';
      if (!staffMap[key]) staffMap[key] = {count:0, revenue:0};
      staffMap[key].count++;
      staffMap[key].revenue += Number(b.paid ? b.netTotal : b.totalPrice) || 0;
    });
    const dayMap = {};
    monthBookings.forEach(b=>{
      if (!dayMap[b.date]) dayMap[b.date] = {count:0, revenue:0};
      dayMap[b.date].count++;
      dayMap[b.date].revenue += Number(b.paid ? b.netTotal : b.totalPrice) || 0;
    });
    const sortedDays = Object.keys(dayMap).sort();
    let html = `
      <div class="stat-grid">
        <div class="stat-card"><div class="stat-value">${totalCount}</div><div class="stat-label">จำนวนคิวทั้งเดือน</div></div>
        <div class="stat-card"><div class="stat-value">${totalBooked.toLocaleString()}</div><div class="stat-label">ยอดจอง (บาท)</div></div>
        <div class="stat-card"><div class="stat-value" style="color:var(--color-blue);">${totalCollected.toLocaleString()}</div><div class="stat-label">เก็บเงินแล้ว (บาท)</div></div>
        <div class="stat-card"><div class="stat-value" style="color:${totalPending>0?'var(--color-danger)':'var(--color-blue)'};">${totalPending}</div><div class="stat-label">รอชำระ (คิว)</div></div>
      </div>
      <h4>👤 แยกตามช่าง</h4>
      <div class="table-wrap"><table class="data-table"><tr><th>ช่าง</th><th>จำนวนคิว</th><th>รายได้ (บาท)</th></tr>
      ${Object.keys(staffMap).length===0 ? '<tr><td colspan="3" style="text-align:center;color:#999;">ไม่มีคิวในเดือนนี้</td></tr>' :
        Object.entries(staffMap).map(([name,v])=>`<tr><td>${name}</td><td>${v.count}</td><td>${v.revenue.toLocaleString()}</td></tr>`).join('')}
      </table></div>
      <h4>📅 แยกตามวัน</h4>
      <div class="table-wrap"><table class="data-table"><tr><th>วันที่</th><th>จำนวนคิว</th><th>รายได้ (บาท)</th></tr>
      ${sortedDays.length===0 ? '<tr><td colspan="3" style="text-align:center;color:#999;">ไม่มีคิว</td></tr>' :
        sortedDays.map(d=>`<tr><td>${d}</td><td>${dayMap[d].count}</td><td>${dayMap[d].revenue.toLocaleString()}</td></tr>`).join('')}
      </table></div>
    `;
    document.getElementById('summaryResult').innerHTML = html;
  }

  /* ================= MANAGEMENT ================= */
  function switchManageTab(tab){
    ['customers','services','staff','shop'].forEach(t=>{
      document.getElementById('tab'+capitalize(t)).classList.toggle('active', t===tab);
      document.getElementById('panel'+capitalize(t)).classList.toggle('active', t===tab);
    });
    if (tab==='customers') renderCustomersTable();
    if (tab==='services') renderServicesTable();
    if (tab==='staff') renderStaffTable();
    if (tab==='shop') renderShopSettingsForm();
  }

  function renderShopSettingsForm(){
    document.getElementById('setShopName').value = shopSettings.name || '';
    document.getElementById('setShopAddress').value = shopSettings.address || '';
    document.getElementById('setShopTaxId').value = shopSettings.taxId || '';
    document.getElementById('setShopPhone').value = shopSettings.phone || '';
    document.getElementById('setShopLine').value = shopSettings.lineId || '';
    document.getElementById('setVatEnabled').checked = !!shopSettings.vatEnabled;
  }

  document.getElementById('shopSettingsForm').addEventListener('submit', function(e){
    e.preventDefault();
    shopSettings.name = document.getElementById('setShopName').value.trim() || 'THE PALETTE STUDIO BY KAT';
    shopSettings.address = document.getElementById('setShopAddress').value.trim();
    shopSettings.taxId = document.getElementById('setShopTaxId').value.trim();
    shopSettings.phone = document.getElementById('setShopPhone').value.trim();
    shopSettings.lineId = document.getElementById('setShopLine').value.trim();
    shopSettings.vatEnabled = document.getElementById('setVatEnabled').checked;
    saveShopSettings();
    document.getElementById('brandNameText').textContent = shopSettings.name;
    alert('บันทึกข้อมูลร้านเรียบร้อยแล้ว');
  });

  /* ---- Customers ---- */
  function openCustomerModal(id=null){
    editingCustomerId = id;
    document.getElementById('quickCustomerForm').reset();
    if (id){
      const c = customers.find(x=>x.id===id);
      document.getElementById('customerModalTitle').textContent = '✏️ แก้ไขลูกค้า';
      document.getElementById('qcName').value = c.name;
      document.getElementById('qcPhone').value = c.phone || '';
    } else {
      document.getElementById('customerModalTitle').textContent = '➕ เพิ่มลูกค้าใหม่';
    }
    document.getElementById('quickCustomerModal').classList.add('show');
  }

  document.getElementById('quickCustomerForm').addEventListener('submit', function(e){
    e.preventDefault();
    const name = document.getElementById('qcName').value.trim();
    const phone = document.getElementById('qcPhone').value.trim();
    if (!name){ alert('กรุณากรอกชื่อลูกค้า'); return; }

    let targetId;
    if (editingCustomerId){
      const idx = customers.findIndex(c=>c.id===editingCustomerId);
      customers[idx] = { ...customers[idx], name, phone };
      targetId = editingCustomerId;
    } else {
      targetId = 'cust'+Date.now();
      customers.push({ id: targetId, name, phone });
    }
    saveCustomers();
    populateCustomerSelect(targetId);
    renderCustomersTable();
    closeModal('quickCustomerModal');
    editingCustomerId = null;
  });

  function renderCustomersTable(){
    const table = document.getElementById('customersTable');
    if (customers.length===0){
      table.innerHTML = '<tr><td style="text-align:center;color:#999;padding:16px;">ยังไม่มีข้อมูลลูกค้า</td></tr>';
      return;
    }
    table.innerHTML = `<tr><th>ชื่อ</th><th>เบอร์โทร</th><th>จัดการ</th></tr>` +
      customers.map(c=>`
        <tr>
          <td>${c.name}</td>
          <td>${c.phone||'-'}</td>
          <td class="actions-cell">
            <button class="btn-edit" onclick="openCustomerModal('${c.id}')">แก้ไข</button>
            <button class="btn-delete" onclick="deleteCustomer('${c.id}')">ลบ</button>
          </td>
        </tr>
      `).join('');
  }

  function deleteCustomer(id){
    if (confirm('ยืนยันการลบลูกค้านี้?')){
      customers = customers.filter(c=>c.id!==id);
      saveCustomers();
      renderCustomersTable();
    }
  }

  /* ---- Services ---- */
  function openServiceModal(id=null){
    editingServiceId = id;
    document.getElementById('serviceForm').reset();
    if (id){
      const s = services.find(x=>x.id===id);
      document.getElementById('serviceModalTitle').textContent = '✏️ แก้ไขบริการ';
      document.getElementById('svName').value = s.name;
      document.getElementById('svPrice').value = s.price;
      document.getElementById('svDuration').value = s.duration;
    } else {
      document.getElementById('serviceModalTitle').textContent = '➕ เพิ่มบริการใหม่';
    }
    document.getElementById('serviceModal').classList.add('show');
  }

  document.getElementById('serviceForm').addEventListener('submit', function(e){
    e.preventDefault();
    const name = document.getElementById('svName').value.trim();
    const price = Number(document.getElementById('svPrice').value);
    const duration = Number(document.getElementById('svDuration').value);
    if (!name){ alert('กรุณากรอกชื่อบริการ'); return; }

    if (editingServiceId){
      const idx = services.findIndex(s=>s.id===editingServiceId);
      services[idx] = { ...services[idx], name, price, duration };
    } else {
      services.push({ id:'svc'+Date.now(), name, price, duration });
    }
    saveServices();
    renderServicesTable();
    closeModal('serviceModal');
    editingServiceId = null;
  });

  function renderServicesTable(){
    const table = document.getElementById('servicesTable');
    if (services.length===0){
      table.innerHTML = '<tr><td style="text-align:center;color:#999;padding:16px;">ยังไม่มีรายการบริการ</td></tr>';
      return;
    }
    table.innerHTML = `<tr><th>ชื่อบริการ</th><th>ราคา</th><th>เวลา (นาที)</th><th>จัดการ</th></tr>` +
      services.map(s=>`
        <tr>
          <td>${s.name}</td>
          <td>${Number(s.price).toLocaleString()}</td>
          <td>${s.duration}</td>
          <td class="actions-cell">
            <button class="btn-edit" onclick="openServiceModal('${s.id}')">แก้ไข</button>
            <button class="btn-delete" onclick="deleteService('${s.id}')">ลบ</button>
          </td>
        </tr>
      `).join('');
  }

  function deleteService(id){
    const usedCount = bookings.filter(b=>b.serviceIds && b.serviceIds.includes(id)).length;
    const msg = usedCount>0 ? `บริการนี้ถูกใช้ในคิวแล้ว ${usedCount} รายการ ต้องการลบหรือไม่? (คิวเดิมจะไม่ถูกลบ)` : 'ยืนยันการลบบริการนี้?';
    if (confirm(msg)){
      services = services.filter(s=>s.id!==id);
      saveServices();
      renderServicesTable();
    }
  }

  /* ---- Staff ---- */
  function openStaffModal(id=null){
    editingStaffId = id;
    document.getElementById('staffForm').reset();
    if (id){
      const s = staffs.find(x=>x.id===id);
      document.getElementById('staffModalTitle').textContent = '✏️ แก้ไขช่าง';
      document.getElementById('stfName').value = s.name;
    } else {
      document.getElementById('staffModalTitle').textContent = '➕ เพิ่มช่างใหม่';
    }
    document.getElementById('staffModal').classList.add('show');
  }

  document.getElementById('staffForm').addEventListener('submit', function(e){
    e.preventDefault();
    const name = document.getElementById('stfName').value.trim();
    if (!name){ alert('กรุณากรอกชื่อช่าง'); return; }

    if (editingStaffId){
      const idx = staffs.findIndex(s=>s.id===editingStaffId);
      staffs[idx] = { ...staffs[idx], name };
    } else {
      staffs.push({ id:'staff'+Date.now(), name });
    }
    saveStaffs();
    populateStaffSelect();
    renderStaffTable();
    renderStaffLegend();
    closeModal('staffModal');
    editingStaffId = null;
  });

  function renderStaffTable(){
    const table = document.getElementById('staffTable');
    if (staffs.length===0){
      table.innerHTML = '<tr><td style="text-align:center;color:#999;padding:16px;">ยังไม่มีข้อมูลช่าง</td></tr>';
      return;
    }
    table.innerHTML = `<tr><th>ช่าง</th><th>จัดการ</th></tr>` +
      staffs.map(s=>{
        const c = getColorForStaff(s.id);
        return `
        <tr>
          <td><span class="staff-color-dot" style="background:${c.text};"></span>${s.name}</td>
          <td class="actions-cell">
            <button class="btn-edit" onclick="openStaffModal('${s.id}')">แก้ไข</button>
            <button class="btn-delete" onclick="deleteStaff('${s.id}')">ลบ</button>
          </td>
        </tr>
      `;
      }).join('');
  }

  function deleteStaff(id){
    const usedCount = bookings.filter(b=>b.staffId===id).length;
    const msg = usedCount>0 ? `ช่างนี้มีคิวอยู่แล้ว ${usedCount} คิว ต้องการลบหรือไม่? (คิวเดิมจะยังคงชื่อช่างเดิมไว้)` : 'ยืนยันการลบช่างนี้?';
    if (confirm(msg)){
      staffs = staffs.filter(s=>s.id!==id);
      saveStaffs();
      populateStaffSelect();
      renderStaffTable();
      renderStaffLegend();
    }
  }

  document.getElementById('brandNameText').textContent = shopSettings.name;
  renderHome();
</script>

</body>
</html>
